# Copy to .env and adjust as needed: cp .env.example .env
# Run with ./dev.sh (or: set -a; source .env; set +a; uvicorn app.main:app --reload)
# so these are exported before uvicorn starts.

UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Must match the frontend's actual origin (see emotion-recognition/.env PORT), or CORS/fetch will fail
FRONTEND_ORIGIN=http://localhost:3001

DATABASE_URL=sqlite:///./app.db
JWT_SECRET_KEY=dev-secret-change-me
APP_ENV=
